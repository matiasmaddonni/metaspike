# Local Supabase — populated by `supabase start`
# Backend / scripts use these (no NEXT_PUBLIC_ prefix):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Next.js client uses NEXT_PUBLIC_* (exposed to browser):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identifier sent in MTGO request User-Agent (please leave a contact)
MTGO_PROBE_UA=metaspike/0.1 (research; you@example.com)
